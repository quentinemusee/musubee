// Type checks everything, tests included, without emitting.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "DOM"],
    "noEmit": true
  },
  "include": ["src", "test", "e2e", "playwright.config.ts", "vitest.config.ts"]
}
