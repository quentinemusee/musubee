# Skills: version our own (musubee- prefix), not copies of third-party skills
.claude/skills/*
!.claude/skills/musubee-*/
# Personal Claude Code settings (the shared ones are in .claude/settings.json)
.claude/settings.local.json

# Secrets and local environment
.env
.env.*
*.pem
*.key
*.keystore
*.p12
*.mobileprovision

# Dependencies and build artifacts
node_modules/
dist/
build/
*.exe
*.dll
*.so
*.dylib
*.aar
*.apk
*.ipa
*.xcframework/
core/bin/

# Python (repository tooling: scripts/)
__pycache__/
*.py[cod]
.venv/

# Local test data and per-run secrets of the test environment
/infra/data/
/infra/.testenv/
*.sqlite
*.sqlite-wal
*.sqlite-shm
