Patch for mautrix-telegram (AGPL-3.0-or-later), applied by infra/telegram/Dockerfile
at the pinned commit. It adds a 'test_servers' option that connects the bridge to
Telegram's test environment (test DCs) instead of production, for automated tests.
Text before the first 'diff --git' line is ignored by git apply.

diff --git a/pkg/connector/client.go b/pkg/connector/client.go
index 9d5721ef..373bedba 100644
--- a/pkg/connector/client.go
+++ b/pkg/connector/client.go
@@ -49,6 +49,7 @@ import (
 	"go.mau.fi/mautrix-telegram/pkg/connector/telegramfmt"
 	"go.mau.fi/mautrix-telegram/pkg/gotd/pool"
 	"go.mau.fi/mautrix-telegram/pkg/gotd/telegram"
+	"go.mau.fi/mautrix-telegram/pkg/gotd/telegram/dcs"
 	"go.mau.fi/mautrix-telegram/pkg/gotd/telegram/auth"
 	"go.mau.fi/mautrix-telegram/pkg/gotd/telegram/updates"
 	"go.mau.fi/mautrix-telegram/pkg/gotd/tg"
@@ -129,6 +130,15 @@ var _ bridgev2.NetworkAPI = (*TelegramClient)(nil)
 
 var messageLinkRegex = regexp.MustCompile(`^https?://t(?:elegram)?\.(?:me|dog)/([A-Za-z][A-Za-z0-9_]{3,31}[A-Za-z0-9]|[Cc]/[0-9]{1,20})/([0-9]{1,20})(?:/([0-9]{1,20}))?$`)
 
+// dcOptions returns the data center list and initial DC: Telegram's test
+// environment when test_servers is enabled, the library defaults otherwise.
+func (tc *TelegramConnector) dcOptions() (dcs.List, int) {
+	if tc.Config.TestServers {
+		return dcs.Test(), 2
+	}
+	return dcs.List{}, 0
+}
+
 func (tc *TelegramConnector) deviceConfig() telegram.DeviceConfig {
 	return telegram.DeviceConfig{
 		DeviceModel:    tc.Config.DeviceInfo.DeviceModel,
@@ -222,7 +232,10 @@ func NewTelegramClient(ctx context.Context, tc *TelegramConnector, login *bridge
 	if err != nil {
 		return nil, err
 	}
+	dcList, dc := tc.dcOptions()
 	client.client = telegram.NewClient(tc.Config.APIID, tc.Config.APIHash, telegram.Options{
+		DCList:               dcList,
+		DC:                   dc,
 		CustomSessionStorage: &login.Metadata.(*UserLoginMetadata).Session,
 		Logger:               zaplog,
 		UpdateHandler:        client.updatesManager,
