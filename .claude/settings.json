{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "dart-flutter@dart-flutter": false
  },
  "permissions": {
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(git update-ref -d *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git config --global *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh release delete *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh auth *)",
      "Bash(gh api *)",
      "Bash(gh workflow disable *)",
      "Bash(gh run delete *)",
      "Bash(gh cache delete *)"
    ]
  }
}
