#
# Appservice registration of the bridge, rendered per run by infra/testenv
# with random tokens (the same as in config.yaml.tmpl). Same content as
# "mautrix-telegram -g" produces; generated by us because the bridge cannot
# rewrite its config file on Docker Desktop bind mounts.
id: telegram
url: http://telegram:29317
as_token: {{.ASToken}}
hs_token: {{.HSToken}}
sender_localpart: {{.SenderLocalpart}}
rate_limited: false
namespaces:
    users:
        - regex: ^@telegrambot:musubee\.test$
          exclusive: true
        - regex: ^@telegram_.*:musubee\.test$
          exclusive: true
de.sorunome.msc2409.push_ephemeral: true
receive_ephemeral: true
