# Skills: version our own (musubee- prefix), not copies of third-party skills
.claude/skills/*
!.claude/skills/musubee-*/
# Personal Claude Code settings (the shared ones are in .claude/settings.json)
.claude/settings.local.json

# Secrets and local environment
.env
.env.*
*.pem
*.key
*.keystore
*.p12
*.mobileprovision

# Dependencies and build artifacts
node_modules/
dist/
dist-bench/
# The thread list benchmark page, copied into the debug app to measure it (ui/README.md).
apps/mobile/www/bench/
build/
*.exe
*.dll
*.so
*.dylib
*.aar
*.apk
*.ipa
*.xcframework/
core/bin/

# Python (repository tooling: scripts/)
__pycache__/
*.py[cod]
.venv/

# Local test data and per-run secrets of the test environment
/infra/data/
/infra/.testenv/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Desktop app build (apps/desktop/scripts/build.mjs) and Playwright output
/apps/desktop/resources/
# iOS memory probe: Xcode project generated by XcodeGen (apps/mobile/ios-probe)
/apps/mobile/ios-probe/MemoryProbe.xcodeproj/
test-results/
playwright-report/
