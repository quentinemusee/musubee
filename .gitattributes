# Normalise line endings: LF in the repository and in working copies, so that
# checkouts on Windows, macOS and Linux are byte-identical.
* text=auto eol=lf

# Windows-only scripts keep CRLF (Windows PowerShell 5.1 and cmd expect it).
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.icns binary
